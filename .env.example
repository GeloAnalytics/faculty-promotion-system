DATABASE_URL="postgresql://user:pass@localhost:5432/faculty_promotion?schema=public"
PORT=3000
NODE_ENV="development"
AUTH_SECRET="change-this-to-a-long-random-production-secret"
CORS_ORIGIN="http://localhost:3000"
TRUST_PROXY=1

# OCR Provider Configuration
# Options: 'windows' (Windows dev), 'tesseract' (default self-hosted deployment), 'google-vision' (recommended for large files & fast cloud OCR), 'http', 'ocrspace', 'disabled'
OCR_PROVIDER="windows"
GOOGLE_VISION_API_KEY=""
OCR_API_URL="https://api.ocr.space/parse/image"
OCR_API_KEY=""
OCR_API_KEY_HEADER="Authorization"
OCR_FILE_FIELD_NAME="file"
OCR_TIMEOUT_MS=30000
# Optional: cloud OCR per-file cap in bytes (default 1048576 = OCR.space free plan).
# Larger pages are re-compressed to fit before upload.
# OCR_MAX_UPLOAD_BYTES=1048576
# Optional: most pages OCR'd per scanned document (default 100).
# OCR_MAX_PAGES=100

# Object Storage (Choose one: Cloudflare R2 [Recommended Free], Generic S3, or Supabase)
# Cloudflare R2 gives 10 GB permanent free storage with $0 egress fees.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="documents"

# Optional: Generic S3 (AWS S3, MinIO, Wasabi, Backblaze B2)
# S3_ENDPOINT="https://s3.us-east-1.amazonaws.com"
# S3_REGION="auto"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_BUCKET_NAME="documents"

# Legacy / Alternative: Supabase Storage
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_ANON_KEY="your-anon-key"

