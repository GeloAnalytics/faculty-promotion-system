generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EMPLOYEE
  EVALUATOR
}

enum DocumentKind {
  REQUIREMENT
  GUIDELINE
  TRAINING_SUPPORT
}

enum TrainingExampleStatus {
  DRAFT
  LABELED
  VALIDATED
}

enum ReviewStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  VERIFIED
  REJECTED
}

enum CriterionDecision {
  PENDING
  APPROVED
  DISAPPROVED
}

enum AuditLogAction {
  UPLOAD
  REPLACE
  DELETE
  VERIFY
  STATUS_CHANGE
  ACCOUNT_DEACTIVATED
  ACCOUNT_REACTIVATED
  ACCOUNT_DELETED
  PASSWORD_RESET
  PASSWORD_CHANGED
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  employeeId         String?            @unique
  passwordHash       String
  passwordSalt       String
  fullName           String
  role               UserRole           @default(EMPLOYEE)
  accountActive      Boolean            @default(true)
  mustChangePassword Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  profiles           FacultyProfile[]
  predictions        Prediction[]
  documents          UploadedDocument[]
  trainingItems      TrainingExample[]
  auditLogs          AuditLog[]
  criterionReviews   CriterionReview[]

  @@map("users")
}

model FacultyProfile {
  id               String             @id @default(cuid())
  employeeId       String?
  name             String
  semester         String?
  features         Json
  teachingQuality  String?
  promotion        Boolean?
  createdByUserId  String?
  createdBy        User?              @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviewStatus     ReviewStatus       @default(DRAFT)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  predictions      Prediction[]
  documents        UploadedDocument[]
  trainingItems    TrainingExample[]
  criterionReviews CriterionReview[]

  @@map("faculty_profiles")
}

model CriterionReview {
  id               String            @id @default(cuid())
  profileId        String
  profile          FacultyProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  panelKey         String
  decision         CriterionDecision @default(PENDING)
  notes            String?
  reviewedByUserId String?
  reviewedBy       User?             @relation(fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([profileId, panelKey])
  @@map("criterion_reviews")
}

model Prediction {
  id                String         @id @default(cuid())
  profileId         String
  profile           FacultyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  probability       Float
  predictedClass    Boolean
  modelUsed         String
  generatedByUserId String?
  generatedBy       User?          @relation(fields: [generatedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime       @default(now())

  @@map("predictions")
}

model UploadedDocument {
  id                 String          @id @default(cuid())
  ownerUserId        String?
  ownerUser          User?           @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  profileId          String?
  profile            FacultyProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  kind               DocumentKind
  originalName       String
  mimeType           String
  extractedText      String?
  extractionMetadata Json?
  createdAt          DateTime        @default(now())

  @@map("uploaded_documents")
}

model TrainingExample {
  id              String                @id @default(cuid())
  createdByUserId String?
  createdBy       User?                 @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  profileId       String?
  profile         FacultyProfile?       @relation(fields: [profileId], references: [id], onDelete: SetNull)
  status          TrainingExampleStatus @default(DRAFT)
  labelPromoted   Boolean?
  labelSource     String?
  datasetSplit    String?
  notes           String?
  rawInput        Json
  featureSnapshot Json
  modelSnapshot   Json?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@map("training_examples")
}

model AuditLog {
  id        String         @id @default(cuid())
  action    AuditLogAction
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  targetId  String
  details   Json?
  createdAt DateTime       @default(now())

  @@map("audit_logs")
}
