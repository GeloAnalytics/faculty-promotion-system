{
  "cleanUrls": true,
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/employee",
      "destination": "/employee.html"
    },
    {
      "source": "/evaluator",
      "destination": "/evaluator.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ]
}
