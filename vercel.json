{
  "framework": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "installCommand": "npm ci --ignore-scripts=false",
  "fluid": true,
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "memory": 1024,
      "includeFiles": "{TQE.csv,DBM-*.pdf,node_modules/{tesseract.js-core/*.wasm,@tesseract.js-data/eng/4.0.0_best_int/*,pdfjs-dist/{package.json,legacy/build/pdf.worker.mjs,standard_fonts/*,cmaps/*},@napi-rs/canvas*/**}}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/employee",
      "destination": "/employee.html"
    },
    {
      "source": "/evaluator",
      "destination": "/evaluator.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ]
}
